{
  "name": "@elide/benchmark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "audit": "lighthouse http://127.0.0.1:4173 --chrome-flags='--headless' --output=json --output-path=./lighthouse.json",
    "test": "bun bundle-check.ts && bun check.mjs && bun platform-check.mjs && bun performance-check.mjs && bun i18n-check.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@elide/ui": "workspace:*",
    "@elide/tokens": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.6",
    "lighthouse": "^13.6.0",
    "tailwindcss": "^4.3.5",
    "playwright": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
