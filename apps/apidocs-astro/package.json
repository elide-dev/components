{
  "name": "@elide/apidocs-astro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Sample Astro app for @elide/apidocs/astro: the Java and Kotlin sample models in two fake versions, with server islands and the client router.",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 5190",
    "build": "astro build",
    "preview": "wrangler dev -c dist/server/wrangler.json --ip 127.0.0.1 --port 5190",
    "lint": "astro sync && tsc --noEmit",
    "test": "bun test --timeout 60000 test/"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.4",
    "@astrojs/preact": "6.1.6",
    "@elide/apidocs": "workspace:*",
    "astro": "7.4.7",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "axe-core": "4.14.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "wrangler": "4.157.0"
  }
}
