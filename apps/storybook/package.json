{
  "name": "@elide/storybook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build --stats-json && bun verify-build.mjs",
    "build-storybook": "bun run build",
    "chromatic": "cd ../.. && bun run chromatic",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@elide/tokens": "workspace:*",
    "@elide/ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@codecov/vite-plugin": "^2.0.1",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-mcp": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "chromatic": "^18.14.2",
    "playwright": "^1.65.0",
    "storybook": "^10.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
