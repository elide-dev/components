{
  "name": "@elide/components-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Elide's shared component catalog and design tokens. Consumed by the docs site (Astro) and the marketing site.",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:preact": "turbo run test --filter=@elide/preact",
    "storybook": "bun run --filter @elide/storybook dev",
    "build-storybook": "turbo run build --filter=@elide/storybook",
    "chromatic": "chromatic",
    "changeset": "changeset",
    "release": "changeset publish",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "@typescript/typescript6": "^6.0.2"
  },
  "overrides": {
    "glob@13": "14.0.4",
    "minimatch@10": "11.0.5",
    "undici@6": "6.29.1",
    "undici@8": "8.12.2"
  },
  "dependencies": {
    "chromatic": "^18.14.2"
  },
  "patchedDependencies": {
    "tsup@9.0.0": "patches/tsup@9.0.0.patch"
  }
}
