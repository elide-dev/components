{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "storybook-static/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "@elide/benchmark#test": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "@elide/benchmark#lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "@elide/preact#test": {
      "dependsOn": ["build", "lint"],
      "cache": false
    },
    "@elide/preact#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/benchmark/src/**"],
      "outputs": ["dist/**"]
    },
    "@elide/preact#lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/benchmark/src/**"]
    }
  }
}
