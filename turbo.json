{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "storybook-static/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "@elide/benchmark#test": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "@elide/benchmark#lint": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
