{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "storybook-static/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "@elide/storybook#build": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"],
      "passThroughEnv": ["CODECOV_TOKEN", "GITHUB_*"]
    },
    "@elide/storybook#lint": {
      "dependsOn": ["^build"]
    },
    "@elide/benchmark#test": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "@elide/benchmark#lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "@elide/elements#test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@elide/elements#lint": {
      "dependsOn": ["^build"]
    },
    "@elide/elements-consumer#test": {
      "dependsOn": ["build", "lint"],
      "cache": false
    },
    "@elide/elements-consumer#lint": {
      "dependsOn": ["^build"]
    },
    "@elide/preact#test": {
      "dependsOn": ["build", "lint"],
      "cache": false
    },
    "@elide/preact#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/benchmark/src/**"],
      "outputs": ["dist/**"]
    },
    "@elide/preact#lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/benchmark/src/**"]
    }
  }
}
