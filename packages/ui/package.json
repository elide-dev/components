{
  "name": "@elide/ui",
  "version": "0.1.0",
  "description": "Elide's React/Preact component catalog, built on shadcn + Base UI and themed entirely from @elide/tokens.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./platform.css": "./src/platform.css",
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./i18n/locales": {
      "types": "./dist/i18n/locales.d.ts",
      "import": "./dist/i18n/locales.js"
    },
    "./i18n/loader": {
      "types": "./dist/i18n/loader.d.ts",
      "import": "./dist/i18n/loader.js"
    },
    "./locales/*": {
      "types": "./dist/i18n/locales/*.d.ts",
      "import": "./dist/i18n/locales/*.js"
    },
    "./locales/*.json": "./src/i18n/locales/*.json",
    "./i18n/messages": {
      "types": "./dist/i18n/messages.d.ts",
      "import": "./dist/i18n/messages.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src && bun run i18n:check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "shadcn": "shadcn",
    "i18n:check": "bun scripts/generate-i18n.ts && bun scripts/check-i18n.ts",
    "i18n:generate": "bun scripts/generate-i18n.ts --write"
  },
  "peerDependencies": {
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@elide/brand": "workspace:*",
    "@elide/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "prism-react-renderer": "^2.4.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/react-vite": "^10.6.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.6",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "tailwindcss": "^4.3.5",
    "shadcn": "4.23.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
