"round" stroke-linejoin="round"><path d="M3 7.5h7.5v2.25a3.75 3.75 0 0 1-7.5 0z"></path><path d="M10.5 8.25h.9a1.6 1.6 0 0 1 0 3.2h-1.2"></path><path d="M5.4 2.4c-.9 1 .9 1.7 0 2.8M8.1 2.4c-.9 1 .9 1.7 0 2.8"></path></g></svg><span>Java</span></span><span class="kind-word">class</span><span class="in-package">in <a href="index.html"><code>fixture.java</code></a></span><span class="badge badge-since">since 1.0</span><span class="badge badge-non-null" title="JSpecify @NullMarked: types are non-null unless annotated">null-marked</span></p></header><div class="sig sig-large"><pre><code><span class="tk-k">public</span> <span class="tk-k">final</span> <span class="tk-k">class</span> <span class="tk-n">Geometry</span></code></pre><button type="button" class="copy" data-copy="true" hidden aria-label="Copy signature" title="Copy signature">Copy</button></div><dl class="lineage"><div><dt>Inheritance</dt><dd><ol class="chain"><li><a href="https://docs.oracle.com/en/java/javase/25/docs/api/java.base/java/lang/Object.html"><code>Object</code></a></li><li aria-current="true"><code>Geometry</code></li></ol></dd></div></dl><section id="doc-description"><div class="fold" data-fold="true"><div class="fold-body"><div class="prose"><p>Operations on <a href="Shape.html"><code>shapes</code></a>.</p><p>Every method is <em>pure</em>: it never modifies its arguments. <strong>Thread safety:</strong> every method is safe to call concurrently.</p><ul><li><p><a href="Geometry.html#largest(java.util.Collection)"><code>largest(Collection)</code></a> picks the largest shape.</p></li><li><p><a href="Geometry.html#totalArea(fixture.java.Shape...)"><code>totalArea(Shape...)</code></a> sums areas.</p></li></ul><ol><li><p>First, measure.</p></li><li><p>Then compare, with <code>compareTo</code>.</p></li></ol><div class="table-scroll"><table class="doc-table"><caption>Unit factors</caption><thead><tr><th scope="col">Unit</th><th scope="col">Factor</th></tr></thead><tbody><tr><td><a href="Units.html#METERS"><code>Units.METERS</code></a></td><td>1.0</td></tr><tr><td><a href="Units.html#FEET"><code>Units.FEET</code></a></td><td>0.3048</td></tr></tbody></table></div><div class="code-block"><pre data-lang="java"><code><span class="hl-t">Shape</span> big = <span class="hl-t">Geometry</span>.<span class="hl-f">largest</span>(<span class="hl-t">List</span>.<span class="hl-f">of</span>(<span class="hl-t">Circle</span>.<span class="hl-f">of</span>(<span class="hl-n">1</span>), <span class="hl-t">Rect</span>.<span class="hl-f">square</span>(<span class="hl-n">2</span>)));
<span class="hl-k">double</span> total = <span class="hl-t">Geometry</span>.<span class="hl-f">totalArea</span>(big, <span class="hl-t">Circle</span>.<span class="hl-f">of</span>(<span class="hl-n">3</span>));</code></pre><button type="button" class="copy" data-copy="true" hidden aria-label="Copy code" title="Copy code">Copy</button></div><blockquote><p>Measure twice, cut once.</p></blockquote><h2 class="doc-heading">Edge cases</h2><p>Text with an entity — a <span class="raw"><sup>superscript</sup></span> kept as raw markup, a line<br/> break, a <a href="https://example.com/spec">hyperlink</a>, and &lt;angle brackets> as literal text.</p></div></div><button type="button" class="fold-toggle" data-js-only="true" aria-expanded="false" hidden>Show more</button></div></section><div class="callout callout-implNote" role="note"><span class="callout-icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16"><path d="M6 4.5 2.75 8 6 11.5M10 4.5 13.25 8 10 11.5"></path></svg></span><div class="callout-body"><p class="callout-label">Implementation note</p><p>Areas are computed in double precision.</p></div></div><div class="see"><h2 class="facts-title">See also</h2><ul class="see-list"><li><a href="Shape.html"><code>Shape</code></a></li><li><a href="Shape.html#area()"><code>the area of a shape</code></a></li><li>&quot;Euclid, Elements, Book I&quot;</li><li><a href="https://en.wikipedia.org/wiki/Area">Area</a></li></ul></div><section id="field-details" class="section members"><h2 class="members-heading"><span>Fields</span><span class="members-count">2</span><button type="button" class="members-toggle" data-expand-all="true" data-js-only="true" aria-expanded="false">Expand all</button></h2><details class="member" data-kind="field"><summary class="member-row"><svg class="member-chevron" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M6 3.75 10.25 8 6 12.25" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="member-sig"><code class="summary-sig"><span class="tk-k">static </span><span class="tk-k">int</span> <span class="member-key">PRECISION</span></code></span><span class="member-brief" data-brief="The default number of significant digits: 6."></span><span class="member-marks"></span></summary><div class="member-body"><header class="member-head" id="PRECISION"><h3 class="member-name"><a class="anchor" href="Geometry.html#PRECISION" aria-label="Field PRECISION">PRECISION</a></h3><span class="member-badges"><span class="badge">static</span></span></header><div class="sig"><pre><code><span class="tk-k">public</span> <span class="tk-k">static</span> <span class="tk-k">final</span> <span class="tk-k">int</span> <span class="tk-n">PRECISION</span></code></pre><button type="button" class="copy" data-copy="true" hidden aria-label="Copy signature" title="Copy signature">Copy</button></div><div class="prose"><p>The default number of significant digits: <code>6</code>.</p></div><div class="facts"><h4 class="facts-title">Value</h4><dl class="facts-list facts-unnamed"><div class="fact"><dt><code class="fact-type"><span class="tk-k">int</span></code></dt><dd>Constant: <code>6</code></dd></div></dl></div></div></details><details class="member" data-kind="field"><summary class="member-row"><svg class="member-chevron" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M6 3.75 10.25 8 6 12.25" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="member-sig"><code class="summary-sig"><span class="tk-k">static </span><span class="tk-t">String</span> <span class="member-key">NAME</span></code></span><span class="member-brief" data-brief="The library's name, &quot;fixture&quot;, as tools report it."></span><span class="member-marks"></span></summary><div class="member-body"><header class="member-head" id="NAME"><h3 class="member-name"><a class="anchor" href="G